# Copy this file to ~/.config/t3-code-mcp.env and chmod 600.
# Keep T3 and OpenAI credentials out of the repository and out of ChatGPT.

# The T3 server owned by this gateway.
T3_HTTP_BASE_URL=http://127.0.0.1:3773
T3_ENVIRONMENT_ID=1884ca63-3d66-4e78-ae67-719b723aac29
T3_ENVIRONMENT_LABEL=coding
T3_ACCESS_TOKEN=

# A separate, randomly generated gateway token. Do not reuse T3_ACCESS_TOKEN.
MCP_BEARER_TOKEN=

# Start conservatively. Change to false only after read-only testing succeeds.
MCP_READ_ONLY=true
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8787
T3_MCP_DATA_DIR=/home/codex/work/t3code-mcp/data

# OpenAI Secure MCP Tunnel runtime key. This is not an admin key.
CONTROL_PLANE_API_KEY=
