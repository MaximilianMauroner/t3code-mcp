[Unit]
Description=T3 Code MCP gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1min
StartLimitBurst=5

# Template: do not edit host paths here. Render host-specific units with:
#   rust/target/release/t3-code-mcp setup --workspace=/opt/t3code-mcp \
#     --executable=/opt/t3code-mcp/rust/target/release/t3-code-mcp \
#     --tunnel-bin=/usr/local/bin/tunnel-client --tunnel-id=tunnel_YOURS \
#     --environment-id=YOUR_ENV_ID
[Service]
Type=simple
WorkingDirectory=/opt/t3code-mcp
EnvironmentFile=%h/.config/t3-code-mcp.env
ExecStart=/opt/t3code-mcp/rust/target/release/t3-code-mcp serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
