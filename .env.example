# T3 environment reached by the gateway. Keep this token server-side.
T3_HTTP_BASE_URL=http://127.0.0.1:3773
T3_ACCESS_TOKEN=

# For GPTVoice through a remote MCP connection, set MCP_TRANSPORT=http.
# The CLI defaults to stdio when unset.
# MCP_TRANSPORT=http

# Required for Streamable HTTP. Leave unset for stdio-only usage.
MCP_BEARER_TOKEN=
# Use true for the initial voice connection check; false enables control tools.
MCP_READ_ONLY=false
MCP_HOST=127.0.0.1
MCP_PORT=8787

# One gateway process controls one T3 environment in v1.
T3_ENVIRONMENT_ID=
T3_ENVIRONMENT_LABEL=

# Durable operation journal. The initial adapter uses a JSON journal to stay
# portable; it is not a substitute for T3's authoritative state.
T3_MCP_DATA_DIR=./data

# Connection/run freshness threshold in milliseconds.
T3_STALE_AFTER_MS=30000
