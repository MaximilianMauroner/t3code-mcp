{
  "name": "t3-code-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP tools for hands-free T3 Code workflows through GPTVoice.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cargo build --locked --release --manifest-path rust/Cargo.toml --bin t3-code-mcp",
    "build:reference": "tsc -p tsconfig.json",
    "dev": "cargo run --quiet --locked --manifest-path rust/Cargo.toml --bin t3-code-mcp -- serve",
    "spike": "cargo run --quiet --locked --manifest-path rust/Cargo.toml --bin t3-code-mcp -- spike",
    "start": "rust/target/release/t3-code-mcp serve",
    "serve": "rust/target/release/t3-code-mcp serve",
    "test": "vitest run",
    "test:live": "T3_LIVE_TESTS=1 vitest run tests/live.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "usage-summary": "cargo run --quiet --locked --manifest-path rust/Cargo.toml --bin t3-code-mcp -- usage-summary",
    "benchmark:audit": "cargo run --quiet --locked --release --manifest-path rust/Cargo.toml --example audit-benchmark"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.22.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
